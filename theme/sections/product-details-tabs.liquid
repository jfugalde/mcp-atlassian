{% assign bg_color = section.settings.bg_color %}

<section
    class="sf-product__section sf-product__section-tabs"
    data-section-type="tabs" data-section-id="{{ section.id }}"
    style="background-color: {{ bg_color }}"
>
  <div class="{{ section.settings.container }}">
    <div class="sf-tabs sf-tabs--responsive sf-pdt__accordion">
      <div class="macross-pdp-tab-header-row w-full max-w-full hidden md:flex border-b border-color-border justify-center">
        {% assign tab_i = 0 %}
        {% for block in section.blocks %}
          {% assign show_tab = true %}
          {% assign mf_rendered = '' %}
          {% if block.type == 'mf_tab' %}
            {%- liquid
              assign _tab_ns = block.settings.metafield_namespace | strip
              assign _tab_ky = block.settings.metafield_key | strip
              assign _tab_ky2 = block.settings.metafield_key_2 | default: '' | strip
              assign _tab_ns2 = block.settings.metafield_namespace_2 | default: '' | strip
              if _tab_ns2 == blank
                assign _tab_ns2 = _tab_ns
              endif
              assign _tab_mf = blank
              if _tab_ns != blank and _tab_ky != blank
                assign _tab_mf = product.metafields[_tab_ns][_tab_ky]
              endif
              if _tab_mf == blank and _tab_ky != blank
                assign _tab_mf = product.metafields.custom[_tab_ky]
              endif
              assign _tab_mf2 = blank
              if _tab_ky2 != blank
                if _tab_ns2 != blank
                  assign _tab_mf2 = product.metafields[_tab_ns2][_tab_ky2]
                endif
                if _tab_mf2 == blank
                  assign _tab_mf2 = product.metafields.custom[_tab_ky2]
                endif
              endif
            -%}
            {% if _tab_ky2 == blank %}
              {% if _tab_mf == blank %}
                {% assign show_tab = false %}
              {% endif %}
            {% else %}
              {% if _tab_mf == blank and _tab_mf2 == blank %}
                {% assign show_tab = false %}
              {% endif %}
            {% endif %}
          {% elsif block.type == 'description' %}
            {% if product.description == blank %}
              {% assign show_tab = false %}
            {% endif %}
          {% endif %}
          {% if show_tab %}
            <div class="sf-tab-header macross-pdp-tab-header-label cursor-pointer" data-index="{{ tab_i }}" {{ block.shopify_attributes }}>
              {{ block.settings.header }}
            </div>
            {% assign tab_i = tab_i | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="md:py-10">
        {% assign tab_i = 0 %}
        {% for block in section.blocks %}
          {% assign show_tab = true %}
          {% assign mf_rendered = '' %}
          {% if block.type == 'mf_tab' %}
            {%- liquid
              assign _tab_ns = block.settings.metafield_namespace | strip
              assign _tab_ky = block.settings.metafield_key | strip
              assign _tab_ky2 = block.settings.metafield_key_2 | default: '' | strip
              assign _tab_ns2 = block.settings.metafield_namespace_2 | default: '' | strip
              if _tab_ns2 == blank
                assign _tab_ns2 = _tab_ns
              endif
              assign _tab_mf = blank
              if _tab_ns != blank and _tab_ky != blank
                assign _tab_mf = product.metafields[_tab_ns][_tab_ky]
              endif
              if _tab_mf == blank and _tab_ky != blank
                assign _tab_mf = product.metafields.custom[_tab_ky]
              endif
              assign _tab_mf2 = blank
              if _tab_ky2 != blank
                if _tab_ns2 != blank
                  assign _tab_mf2 = product.metafields[_tab_ns2][_tab_ky2]
                endif
                if _tab_mf2 == blank
                  assign _tab_mf2 = product.metafields.custom[_tab_ky2]
                endif
              endif
            -%}
            {% if _tab_ky2 == blank %}
              {% if _tab_mf == blank %}
                {% assign show_tab = false %}
              {% else %}
                {% capture mf_rendered %}
                  {% render 'product-tab-metafield', product: product, block: block %}
                {% endcapture %}
              {% endif %}
            {% else %}
              {% if _tab_mf == blank and _tab_mf2 == blank %}
                {% assign show_tab = false %}
              {% else %}
                {% capture mf_rendered %}
                  {% render 'product-tab-metafield', product: product, block: block %}
                {% endcapture %}
              {% endif %}
            {% endif %}
          {% elsif block.type == 'description' %}
            {% if product.description == blank %}
              {% assign show_tab = false %}
            {% endif %}
          {% endif %}
          {% if show_tab %}
            <div
              class="sf__accordion-item sf-tab-content md:opacity-0{% if tab_i == 0 and section.settings.default_open %} open{% endif %}"
              data-block-type="{{ block.type }}"
              {% if tab_i > 0 and section.settings.default_open == false %}
                style="--content-max-height:0px;"
              {% endif %}
            >
              <div class="sf__accordion-button macross-pdp-tab-header-mobile pb-3 pr-4">{{ block.settings.header }}</div>
              <div class="sf__accordion-content">
                <div
                  class="macross-pdp-tab-panel pb-8{% if block.type == 'reviews' %} macross-pdp-tab-panel--reviews{% else %} macross-pdp-tab-panel--body rte prose max-w-none{% endif %}"
                >
                  {% case block.type %}
                    {% when 'description' %}
                      {%- assign description = product.description | replace: 'src=', 'loading="lazy" width="auto" height="auto" src=' -%}
                      <div class="macross-pdp-tab-panel__flow">
                        {{ description }}
                      </div>
                    {% when 'reviews' %}
                      <div class="macross-pdp-tab-panel__flow {{ block.settings.container | default: 'container' }}">
                        {% render 'product-reviews-app__snippet', custom_liquid: block.settings.custom_liquid %}
                      </div>
                    {% when 'tab' %}
                      <div class="macross-pdp-tab-panel__flow">
                        {{ block.settings.content }}
                        {{ block.settings.content_page.content }}
                      </div>
                    {% when 'liquid' %}
                      <div class="macross-pdp-tab-panel__flow">
                        {{ block.settings.custom_liquid }}
                      </div>
                    {% when 'mf_tab' %}
                      <div class="macross-pdp-tab-panel__flow">
                        {{ mf_rendered }}
                      </div>
                    {% else %}
                  {% endcase %}
                </div>
              </div>
            </div>
            {% assign tab_i = tab_i | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

</section>
<script>
  window.themeScriptURLs.tabs.required = true
</script>

{% stylesheet %}
  /* Desktop: active tab panel must stay visible (Tabs sets opacity async; Accordion needs real scrollHeight). */
  @media (min-width: 768px) {
    .sf-product__section-tabs .sf-tab-content.active {
      opacity: 1 !important;
    }
  }

  /* PDP tab labels — single line, bold; no scrollport (clip + hide scrollbars; avoids subpixel “mini scroll”) */
  .sf-product__section-tabs .sf-tabs.sf-tabs--responsive.sf-pdt__accordion {
    overflow-x: visible;
    overflow-y: visible;
  }

  .macross-pdp-tab-header-row {
    flex-wrap: nowrap;
    justify-content: center;
    align-items: stretch;
    box-sizing: border-box;
    column-gap: 0.5rem;
    max-width: 100%;
    overflow-x: clip;
    overflow-y: visible;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-y;
  }

  .macross-pdp-tab-header-row::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .macross-pdp-tab-header-row .sf-tab-header.macross-pdp-tab-header-label {
    flex: 0 0 auto;
    white-space: nowrap;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
    text-align: center;
    padding-inline: 1rem;
    padding-block: 0.75rem 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .macross-pdp-tab-header-row .sf-tab-header.macross-pdp-tab-header-label {
      font-size: 1rem;
      padding-inline: 0.65rem;
    }
  }

  .sf-product__section-tabs .sf__accordion-button.macross-pdp-tab-header-mobile {
    font-weight: 600;
    white-space: nowrap;
    font-size: 1.125rem;
    line-height: 1.35;
    padding-top: 0.85rem;
    padding-bottom: 1rem;
    padding-right: 1.25rem;
  }

  /* PDP information tabs — full width of section container (readable typography below) */
  .macross-pdp-tab-panel--body {
    --macross-tab-font: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-family: var(--macross-tab-font);
    font-size: 1rem;
    line-height: 1.65;
    max-width: none;
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    color: var(--color-body-text, #1a1a1a);
  }

  .macross-pdp-tab-panel--body :where(p, li, td, th) {
    font-size: 1rem;
    line-height: 1.65;
  }

  .macross-pdp-tab-panel--body :where(ul, ol) {
    margin-top: 0.65em;
    margin-bottom: 0.65em;
    padding-inline-start: 1.35em;
  }

  .macross-pdp-tab-panel--body :where(ul) li + li,
  .macross-pdp-tab-panel--body :where(ol) li + li {
    margin-top: 0.35em;
  }

  .macross-pdp-tab-panel--body :where(h1, h2, h3, h4) {
    margin-top: 1.35em;
    margin-bottom: 0.45em;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-body-text, #111);
  }

  .macross-pdp-tab-panel--body :where(h1, h2, h3, h4):first-child {
    margin-top: 0;
  }

  .macross-pdp-tab-panel--body :where(strong, b) {
    font-weight: 600;
  }

  .macross-pdp-tab-panel__flow > :first-child {
    margin-top: 0;
  }

  .macross-pdp-tab-panel__flow > :last-child {
    margin-bottom: 0;
  }

  .macross-pdp-tab-panel__segment :first-child {
    margin-top: 0;
  }

  .macross-pdp-tab-panel__segment + .macross-pdp-tab-panel__segment {
    margin-top: 1.25rem;
  }

  .macross-pdp-tab-panel__subheading {
    margin: 0 0 0.75rem;
    padding-top: 1.35rem;
    margin-top: 1.35rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    font-family: var(--macross-tab-font, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--color-body-text, #333);
    opacity: 0.88;
  }

  .macross-pdp-tab-panel__subheading--first {
    padding-top: 0;
    margin-top: 0;
    border-top: none;
  }

  .macross-pdp-tab-panel--reviews {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    max-width: none;
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    color: var(--color-body-text, #1a1a1a);
  }

  .macross-pdp-tab-panel--reviews .macross-pdp-tab-panel__flow {
    max-width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product information tabs",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Fixed width"
        },
        {
          "value": "container-fluid",
          "label": "Stretched width"
        },
        {
          "value": "container-narrow",
          "label": "Narrow width"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Default open first tab on mobile",
      "default": true
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the Shopify product description (body HTML). Hidden if the body is empty. Use one block."
        },
        {
          "type": "text",
          "id": "header",
          "label": "Tab header",
          "default": "Description"
        }
      ]
    },
    {
      "type": "reviews",
      "name": "Product reviews",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Requirements",
          "info": "This section requires a product reviews app to work. Such as Shopify product reviews, Growave, Judge.me, Loox"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Tab header",
          "default": "Product reviews"
        },
        {
          "type": "select",
          "id": "container",
          "label": "Container type",
          "default": "container",
          "options": [
            {
              "value": "container",
              "label": "Fixed width"
            },
            {
              "value": "container-fluid",
              "label": "Stretched width"
            },
            {
              "value": "container-narrow",
              "label": "Narrow width"
            }
          ]
        },
        {
          "type": "header",
          "content": "Other review app"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid",
          "info": "Paste the liquid code of the app review here"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Custom content",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "Shipping & Return",
          "placeholder": "Shipping & Return"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Shipping cost is based on weight. Just add products to your cart and use the Shipping Calculator to see the shipping price.</p><p>We want you to be 100% satisfied with your purchase. Items can be returned or exchanged within 30 days of delivery.</p>"
        },
        {
          "type": "page",
          "id": "content_page",
          "label": "Tab content from page"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "Tab heading"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid"
        }
      ]
    },
    {
      "type": "mf_tab",
      "name": "Product metafield",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "Preguntas frecuentes",
          "info": "Tab hidden if this metafield is empty for the product."
        },
        {
          "type": "text",
          "id": "metafield_namespace",
          "label": "Metafield namespace",
          "default": "custom",
          "info": "Usually custom."
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield key",
          "default": "macross_faq",
          "info": "e.g. macross_faq, macross_envio (see metafieldDefinitions in Admin API)."
        },
        {
          "type": "text",
          "id": "metafield_namespace_2",
          "label": "Second metafield namespace (optional)",
          "info": "Leave blank to reuse the first namespace. Used to show two metafields in one tab."
        },
        {
          "type": "text",
          "id": "metafield_key_2",
          "label": "Second metafield key (optional)",
          "info": "If set, this metafield is shown below the first. Tab is shown if either field has content."
        },
        {
          "type": "text",
          "id": "secondary_block_heading",
          "label": "Heading above second metafield",
          "default": "Conservación",
          "info": "Only used when a second metafield key is set. Leave blank to omit the subheading."
        }
      ]
    }
  ]
}
{% endschema %}
