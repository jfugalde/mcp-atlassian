<script src="{{ 'product.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign container = section.settings.container
  assign layout = section.settings.layout
  if layout == 'layout-7'
    assign container = 'w-full'
  endif
  assign first_3d_model = product.media | where: "media_type", "model" | first

  capture is_preorder
    render 'check-preorder', product: product
  endcapture

  if is_preorder == "true"
    assign is_preorder = true
  else
    assign is_preorder = false
  endif
-%}
{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
<div
  data-section-type="product-page"
  data-discount-pdp="true"
  data-section-id="{{ section.id }}"
  data-layout="{{ layout }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-id="{{ product.id }}"
  data-container="{{ container }}"
  class="product-template discount-pdp md:mt-4 mb-5 md:mb-12"
>
  {%- liquid
    assign macross_promo_marker_setting = section.settings.macross_promo_alt_marker | default: '[macross-promo]'
    assign macross_promo_token = macross_promo_marker_setting | strip | downcase
    assign macross_gallery_count = product.media.size
    assign macross_mobile_preview_media = product.featured_media
    if macross_promo_token != blank
      assign macross_gallery_count = 0
      assign macross_mobile_preview_set = false
      for pm_gallery in product.media
        assign pm_gallery_alt = pm_gallery.preview_image.alt | default: '' | strip | downcase
        unless pm_gallery_alt contains macross_promo_token
          assign macross_gallery_count = macross_gallery_count | plus: 1
          unless macross_mobile_preview_set
            assign macross_mobile_preview_media = pm_gallery
            assign macross_mobile_preview_set = true
          endunless
        endunless
      endfor
      unless macross_mobile_preview_set
        assign macross_mobile_preview_media = product.featured_media
      endunless
    endif
    assign macross_mobile_aspect_ratio = macross_mobile_preview_media.preview_image.aspect_ratio | default: macross_mobile_preview_media.aspect_ratio | default: 1

    assign masthead_promo_image = section.settings.masthead_promo_image
    assign masthead_promo_alt = section.settings.masthead_promo_image_alt | strip
    if masthead_promo_image == blank and section.settings.use_product_media_promo_when_masthead_empty and macross_promo_token != blank
      for pm_mast in product.media
        assign pm_mast_alt = pm_mast.preview_image.alt | default: '' | strip | downcase
        if pm_mast_alt contains macross_promo_token
          assign masthead_promo_image = pm_mast.preview_image
          if masthead_promo_alt == blank
            assign masthead_promo_alt = pm_mast.alt | default: pm_mast.preview_image.alt | default: '' | strip
          endif
          break
        endif
      endfor
    endif

    assign masthead_has_promo = false
    if masthead_promo_image != blank
      assign masthead_has_promo = true
    endif
  -%}
  <div class="discount-pdp__masthead">
    <div
      class="{{ container }} discount-pdp__masthead-inner{% if masthead_has_promo %} discount-pdp__masthead-inner--promo{% endif %}"
    >
      {% if masthead_has_promo %}
        <div class="discount-pdp__masthead-promo discount-pdp__masthead-promo--well">
          {% if masthead_promo_alt != blank %}
            {% render 'responsive-image',
              image: masthead_promo_image,
              alt: masthead_promo_alt,
              wrapper_class: 'discount-pdp__masthead-promo__img',
              image_class: 'w-full h-auto max-h-[5.5rem] md:max-h-[7.5rem] object-contain rounded-lg',
              lazy_load: false
            %}
          {% else %}
            {% render 'responsive-image',
              image: masthead_promo_image,
              wrapper_class: 'discount-pdp__masthead-promo__img',
              image_class: 'w-full h-auto max-h-[5.5rem] md:max-h-[7.5rem] object-contain rounded-lg',
              lazy_load: false
            %}
          {% endif %}
        </div>
        <div class="discount-pdp__masthead-stack">
      {% endif %}
      {% if section.settings.show_masthead_label %}
        <p class="discount-pdp__masthead-label">{{ section.settings.masthead_label | escape }}</p>
      {% endif %}
      {% render 'pdp-discount-hero', product: product, section: section %}
      {% if masthead_has_promo %}
        </div>
      {% endif %}
    </div>
  </div>
  <div class="{{ container }}">
    <div class="sf-prod-template sf-product-wrapper sf-prod-template__desktop {% if section.settings.show_zoom_button %}enable-zoom{% endif %}">
      {% liquid
        assign media_class = 'w-full md:w-1/2'
        assign info_class = 'w-full md:w-1/2'
        assign wrapper_class = 'flex flex-wrap sf-prod__container'
        case section.settings.layout
          when 'layout-2'
            assign media_class = 'w-full md:w-7/12'
            assign info_class = 'w-full md:w-5/12'
          when 'layout-3'
            assign media_class = 'w-full md:w-7/12'
            assign info_class = 'w-full md:w-5/12 sf-prod__summary'
          when 'layout-5'
            assign media_class = 'w-full md:w-7/12'
            assign info_class = 'w-full md:w-5/12 sf-prod__summary'
          when 'layout-7'
            assign media_class = ''
            assign info_class = 'container-narrow md:text-center'
            assign wrapper_class = 'sf-prod__layout-7 layout-slider-2'
        endcase
      %}
      <div class="{{ wrapper_class }} sf-prod__block">
        <div class="{{ media_class }}">
          <div class="sf-product-media__desktop sf-prod-media__wrapper justify-end hidden md:block sf-prod__{{ section.settings.layout }}">
            {% render 'product-media', section: section, template_product: true, class: 'hidden md:block', swiper_class: 'f-media-desktop', macross_promo_alt_marker: macross_promo_marker_setting %}
          </div>
          <div class="sf-product-media__mobile md:hidden">
            <div class="product-mb__media product-page-mobile__slider {% if macross_mobile_aspect_ratio < 1 %}px-5{% endif %}">
              {% if macross_gallery_count <= 1 %}
                <div
                  class="flex justify-center items-center relative sf-prod-media-item media-type-{{ macross_mobile_preview_media.media_type }}"
                  data-index="0"
                >
                  {% render 'product-media', screen: 'mobile', template_product: true, section: section, swiper_class: 'f-media-mobile', macross_promo_alt_marker: macross_promo_marker_setting %}
                </div>
              {% else %}
                {%- liquid 
                  render 'product-media', screen: 'mobile', template_product: true, position: 'right-5 bottom-2.5', swiper_class: 'f-media-mobile', class: 'md:hidden', section: section, media_layout: 'layout-4', show_nav: false, show_thumbnails: section.settings.show_nav_media_mobile, show_pagination: section.settings.show_pagination_mobile, macross_promo_alt_marker: macross_promo_marker_setting
                -%}
              {% endif %}
              {% if section.settings.show_atwl %}
                {%- liquid 
                  assign wishlist_app = settings.wishlist_app
                -%}
                {% if wishlist_app == 'growave' %}
                  {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
                  <div class="product-mb__atwl">
                    {% unless the_snippet_fave_icon contains 'Liquid error' %}
                      {{ the_snippet_fave_icon }}
                    {% else %}
                      {% render 'mm-ssw-widget-faveicon' with product.id %}
                    {% endunless %}
                  </div>
                {% else %}
                  {% render 'tooltip', type: 'wishlist', product: product, class_name: "sf__tooltip-top product-mb__atwl" %}
                {% endif %}
              {% endif %}
            </div>
            {%- if first_3d_model -%}
              <div class="mt-4 md:hidden">
                <button
                  class="custom-xr-button sf__btn w-full items-center justify-center"
                  type="button"
                  aria-label="{%- render 'new-locale', key: 'products.product.xr_button_label' -%}"
                  data-shopify-xr
                  data-shopify-model3d-id="{{ first_3d_model.id }}"
                  data-shopify-title="title"
                  data-shopify-xr-hidden
                >
                  <svg class="w-[16px] h-[16px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 18 21">
                    <path d="M7.67998 20.629L1.28002 16.723C0.886205 16.4784 0.561675 16.1368 0.337572 15.731C0.113468 15.3251 -0.00274623 14.8686 -1.39464e-05 14.405V6.59497C-0.00238367 6.13167 0.113819 5.6755 0.33751 5.26978C0.561202 4.86405 0.884959 4.52227 1.278 4.27698L7.67796 0.377014C8.07524 0.131403 8.53292 0.000877102 8.99999 9.73346e-08C9.46678 -0.000129605 9.92446 0.129369 10.322 0.374024V0.374024L16.722 4.27399C17.1163 4.51985 17.4409 4.86287 17.6647 5.27014C17.8885 5.67742 18.0039 6.13529 18 6.59998V14.409C18.0026 14.8725 17.8864 15.3289 17.6625 15.7347C17.4386 16.1405 17.1145 16.4821 16.721 16.727L10.321 20.633C9.92264 20.8742 9.46565 21.0012 8.99999 21C8.53428 20.9998 8.07761 20.8714 7.67998 20.629V20.629ZM8.72398 2.078L2.32396 5.97803C2.22303 6.04453 2.14066 6.13551 2.08452 6.24255C2.02838 6.34959 2.00031 6.46919 2.00298 6.59003V14.4C2.00026 14.5205 2.02818 14.6396 2.08415 14.7463C2.14013 14.853 2.22233 14.9438 2.32298 15.01L7.99999 18.48V10.919C8.00113 10.5997 8.08851 10.2867 8.25292 10.0129C8.41732 9.73922 8.65267 9.51501 8.93401 9.36401L15.446 5.841L9.28001 2.08002C9.19614 2.02738 9.09901 1.99962 8.99999 2C8.90251 1.99972 8.8069 2.02674 8.72398 2.078V2.078Z" fill="currentColor"></path>
                  </svg>
                  <span class="ml-2">{%- render 'new-locale', key: 'products.product.xr_button' -%}</span>
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>
        <div class="{{ info_class }}">
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign compare_at_price = variant.compare_at_price
            assign price = variant.price
            if compare_at_price == blank or compare_at_price == 0
              if product.has_only_default_variant
                assign compare_at_price = product.compare_at_price_max
              endif
            endif
            if compare_at_price == blank
              assign compare_at_price = 0
            endif
            assign on_sale = false
            if compare_at_price > price
              assign _sale_saved = compare_at_price | minus: price
              if _sale_saved > 0
                assign _sale_pct = _sale_saved | times: 100.0 | divided_by: compare_at_price | round
                if _sale_pct >= 1
                  assign on_sale = true
                endif
              endif
            endif
            assign ph_only_when_on_sale = section.settings.discount_only_when_on_sale | default: false
            assign discount_hero_band_visible = true
            if ph_only_when_on_sale and on_sale == false
              assign discount_hero_band_visible = false
            endif
          -%}
          <div class="sf-prod__info-wrapper">
            <div class="sf-prod__info{% if on_sale %} sf-product--onsale{% endif %}">
              {% if discount_hero_band_visible %}
                <div class="discount-pdp__variant-price-sync visually-hidden" aria-hidden="true">
                  {% render 'product-prices', use_variant: true, product: product, show_sale_badge: false, price_text_size: 'text-xl md:text-2xl' %}
                </div>
              {% endif %}
              {% render 'main-product-blocks', section: section, product: product, is_preorder: is_preorder, discount_hero_band_visible: discount_hero_band_visible %}
              <div class="addons-block">
                <div
                  id="fox-product-bundle-inside"
                  data-fox-app="true"
                  data-section-product-bundle
                ></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {% render 'pdp-professional-health-disclaimer' %}
    </div>
    {%- for block in section.blocks -%}
      {% if block.type == 'addons' and block.settings.show_ask_a_question %}
        {% render 'form__ask-a-question' %}
        {% break %}
      {% endif %}
    {%- endfor -%}
  </div>

  {% if section.settings.use_sticky_atc or section.settings.use_sticky_atc_on_mobile %}
    {% render 'sticky-atc', section: section, product: product, first_3d_model: first_3d_model, is_preorder: is_preorder %}
  {% endif %}
</div>

{% if product.media.size > 0 %}
  <script src="{{ 'product-media.min.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- if first_3d_model -%}
  <script type="application/json" id="ModelJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script src="{{ 'product-model-new.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% if product.options_with_values.size > 0 %}
  <script src="{{ 'variant-picker.min.js' | asset_url }}" defer="defer"></script>
{% endif %}
<script src="{{ 'discount-pdp-hero-sync.js' | asset_url }}" defer="defer"></script>
<div
  id="fox-product-bundle-outside"
  data-fox-app="true"
  data-section-product-bundle
></div>

{%- render 'product-data' -%}

{% stylesheet %}
  .product__description--pdp-vertical {
    margin-top: 1rem;
  }
  .product__description--pdp-vertical h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
  }
  .product__description--pdp-vertical ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .product__description--pdp-vertical p {
    margin-bottom: 0.75rem;
  }

  /* Macross Pharma — same palette as PDP disclaimer + mark */
  .discount-pdp {
    position: relative;
    color-scheme: light;
    color: var(--mp-charcoal, #131110);
    /* One UI stack + theme heading for display moments (matches storefront fonts) */
    --discount-pdp-font-ui: var(
      --font-stack-body,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif
    );
    --discount-pdp-font-display: var(
      --font-stack-header,
      var(--font-stack-body),
      ui-sans-serif,
      system-ui,
      sans-serif
    );
    --mp-red: #b33029;
    --mp-red-dark: #8c241f;
    --mp-red-soft: #d45850;
    /* Disclaimer uses #14221c (reads green on big fields) — offer UI uses warm charcoal */
    --mp-charcoal: #131110;
    --mp-charcoal-mid: #1c1817;
    --mp-charcoal-deep: #0a0909;
    --mp-gray: #555555;
    --mp-silver: #c4c4c4;
    --mp-border: #666666;
    --mp-paper: #ffffff;
    --mp-warm-paper: #f6f1e7;
  }

  .discount-pdp::before {
    display: none;
  }

  .discount-pdp__masthead {
    position: relative;
    background: transparent;
    padding: 0.75rem 0 1rem;
    margin-bottom: 0.75rem;
    border-bottom: none;
  }

  .discount-pdp__masthead::after {
    display: none;
  }

  .discount-pdp__masthead-inner {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .discount-pdp__masthead-inner--promo {
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .discount-pdp__masthead-inner--promo {
      display: grid;
      grid-template-columns: minmax(4.5rem, 8.75rem) minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.65rem;
      align-items: start;
    }

    .discount-pdp__masthead-promo {
      grid-row: 1 / span 2;
    }

    .discount-pdp__masthead-stack {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      min-width: 0;
    }
  }

  .discount-pdp__masthead-promo__img {
    display: block;
    width: 100%;
    max-width: 10rem;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .discount-pdp__masthead-promo__img {
      margin-left: 0;
      margin-right: 0;
      max-width: none;
    }
  }

  .discount-pdp__masthead-promo--well {
    align-self: start;
    padding: 0.5rem;
    border-radius: 0.65rem;
    background: rgba(179, 48, 41, 0.06);
    border: 1px solid rgba(102, 102, 102, 0.2);
  }

  .discount-pdp__masthead-label {
    margin: 0;
    font-family: var(--discount-pdp-font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2a2220;
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .discount-pdp__masthead {
      padding: 0.5rem 0 0.75rem;
      margin-bottom: 0.5rem;
    }
  }


  /*
   * Layout-6 (thumbs + main): align to start so the media column doesn’t stretch
   * with empty space below thumbnails (was worsened by full-height gallery fills).
   */
  .discount-pdp .sf-prod-media__wrapper.sf-prod__layout-6 {
    align-items: flex-start;
  }

  .discount-pdp .sf-prod-media__wrapper.sf-prod__layout-6 .nav-swiper-container {
    align-items: flex-start;
  }

  .discount-pdp .sf-prod-media__wrapper.sf-prod__layout-6 .sf-media-nav {
    align-self: flex-start;
  }

  .discount-pdp #fox-product-bundle-inside:empty {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Discount PDP",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "layout-6",
      "options": [
        {
          "value": "layout-4",
          "label": "Standard"
        },
        {
          "value": "layout-1",
          "label": "Grid 1 column"
        },
        {
          "value": "layout-3",
          "label": "Grid 2 columns"
        },
        {
          "value": "layout-2",
          "label": "Grid mix"
        },
        {
          "value": "layout-5",
          "label": "Slider 2 columns"
        },
        {
          "value": "layout-6",
          "label": "Slider vertical"
        },
        {
          "value": "layout-7",
          "label": "Slider full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_atwl",
      "label": "Show Add to wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_history_state",
      "label": "Enable history state",
      "info": "This will add a '?variant={variant_id}' to the browser's URL",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_variant_group_images",
      "label": "Enable variant group images",
      "default": false
    },
    {
      "type": "header",
      "content": "Product media"
    },
    {
      "type": "checkbox",
      "id": "show_featured_media",
      "label": "Show featured media by default",
      "default": true,
      "info": "If unchecked, the selected variant's image will be show on page load."
    },
    {
      "type": "checkbox",
      "id": "show_zoom_button",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_autoplay",
      "label": "Enable video autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_nav_media_mobile",
      "label": "Show thumbnails on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show pagination on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Sticky Add to cart"
    },
    {
      "type": "checkbox",
      "id": "use_sticky_atc",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_sticky_atc_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_wishtlist",
      "label": "Show wishlist button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_compare",
      "label": "Show compare button",
      "default": false
    },
    {
      "type": "header",
      "content": "Discount page (masthead)"
    },
    {
      "type": "paragraph",
      "content": "Full-width discount hero above the standard product columns. Use this section only on the “discount” product template. Tier labels follow discount depth (theme locales macross.pdp_sale_tier_*)."
    },
    {
      "type": "checkbox",
      "id": "show_masthead_label",
      "label": "Show masthead label",
      "default": true
    },
    {
      "type": "text",
      "id": "masthead_label",
      "label": "Masthead label",
      "default": "Oferta especial · Macross",
      "info": "Short line above the discount hero (e.g. “Discount PDP”)."
    },
    {
      "type": "image_picker",
      "id": "masthead_promo_image",
      "label": "Masthead promo image",
      "info": "Optional image in the discount banner (e.g. gift-with-purchase). Shown beside the offer on desktop, above on mobile."
    },
    {
      "type": "text",
      "id": "masthead_promo_image_alt",
      "label": "Promo image alt text",
      "info": "Describe the promo for screen readers (e.g. “promo” or “Regalo con compra”). Leave blank to use the image file’s alt in Shopify when set."
    },
    {
      "type": "text",
      "id": "macross_promo_alt_marker",
      "label": "Promo marker in product media alt",
      "default": "[macross-promo]",
      "info": "Case-insensitive. Product media whose preview alt contains this substring is used for the masthead (when enabled below) and is hidden from the main PDP gallery on this template."
    },
    {
      "type": "checkbox",
      "id": "use_product_media_promo_when_masthead_empty",
      "label": "Use first marked product media when masthead image is empty",
      "default": true,
      "info": "If the masthead promo image picker is empty, the first product image whose alt contains the marker above becomes the masthead promo."
    },
    {
      "type": "checkbox",
