{{ 'sf-collection-icons.css' | asset_url | stylesheet_tag }}

<section
  id="sf-collection-cta-{{ section.id }}"
  class="sf-collection-cta sf-section-padding {{ section.settings.custom_class }}"
  data-section-id="{{ section.id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section.settings.container }}{% if section.settings.container != 'w-full' %} section-my{% endif %}">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="sf-collection-cta__header text-{{ section.settings.header_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="sf-collection-cta__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="sf-collection-cta__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="sf-icon-strip sf-collection-cta__strip">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- if collection != blank -%}
          {%- assign pill_title = block.settings.title | default: collection.title -%}
          <a href="{{ collection.url }}" class="sf-icon-pill" {{ block.shopify_attributes }}>
            {%- render 'collection-icon', collection: collection, size: 'text-3xl', icon_override: block.settings.fa_icon -%}
            <span class="sf-icon-pill__label">{{ pill_title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="sf-collection-cta__actions text-{{ section.settings.header_alignment }}">
        <a href="{{ section.settings.button_link | default: '/collections' }}" class="sf__btn sf__btn-primary">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection CTA strip",
  "tag": "section",
  "class": "section-collection-cta-strip",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Ver todas las categorías"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Container box" },
        { "value": "w-full", "label": "Edge to edge" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "default": "sf-home__explora-cta"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label (optional)"
        },
        {
          "type": "text",
          "id": "fa_icon",
          "label": "Icon (Font Awesome classes)",
          "info": "e.g. fa-solid fa-heart-pulse. Requires Theme settings → Icons."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection CTA strip",
      "category": "Collection",
      "settings": {
        "button_label": "Ver todas las categorías",
        "button_link": "/collections"
      },
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}
