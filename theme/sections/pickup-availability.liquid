{% comment %}theme-check-disable UndefinedObject{% endcomment %}

{%- assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true -%}
{%- liquid
  assign priority_pickup_raw = settings.macross_priority_pickup_location_id | strip
  assign priority_pickup_location_id = false
  if priority_pickup_raw != blank
    assign priority_pickup_location_id = priority_pickup_raw | plus: 0
  endif
  assign priority_availability = false
  if priority_pickup_location_id
    for sa in pick_up_availabilities
      if sa.location.id == priority_pickup_location_id
        assign priority_availability = sa
        break
      endif
    endfor
  endif
-%}

{%- if pick_up_availabilities.size > 0 -%}
  <pickup-availability-preview class="pickup-availability-preview pickup-availability-preview--inline flex flex-col w-full">
    <p class="font-medium mb-2">
      {{- 'products.product.pickup_availability.inline_heading' | t -}}
    </p>
    {%- unless product_variant.product.has_only_default_variant -%}
      <p class="pickup-availability-variant text-color-secondary text-sm mb-4">
        {%- for product_option in product_variant.product.options_with_values -%}
          {{ product_option.name | escape }}:&nbsp;
          {%- for value in product_option.values -%}
            {%- if product_option.selected_value == value -%}
              <span>{{ value | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- unless forloop.last -%},&nbsp;{%- endunless -%}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    <div class="pickup-availability-dropdowns flex flex-col gap-3 w-full" role="list">
      {%- if priority_availability -%}
        {% render 'pickup-availability-location', availability: priority_availability, details_open: true, product_variant: product_variant %}
        {%- for availability in pick_up_availabilities -%}
          {%- if availability.location.id != priority_pickup_location_id -%}
            {% render 'pickup-availability-location', availability: availability, details_open: false, product_variant: product_variant %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for availability in pick_up_availabilities -%}
          {% render 'pickup-availability-location', availability: availability, details_open: forloop.first, product_variant: product_variant %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </pickup-availability-preview>
{%- endif -%}
