{%- unless collection.filters == empty -%}
  <div>
    <p id="CollectionProductCountDesktop" class="collection-product-count light" role="status">
      {{-
        'sections.collection_template.product_count'
        | t: product_count: collection.products_count, count: collection.all_products_count
      -}}
    </p>
  </div>
{%- endunless -%}