{%- comment -%}
  One resolved product metafield: metafield_tag first; if empty, fall back to .value (e.g. rich text edge cases).
{%- endcomment -%}
{%- if mf != blank -%}
  <div class="macross-pdp-tab-panel__segment">
    {%- if mf.type == 'single_line_text_field' and mf.value != blank -%}
      <p class="m-0">{{ mf.value }}</p>
    {%- elsif mf.type == 'multi_line_text_field' and mf.value != blank -%}
      <p class="m-0 whitespace-pre-wrap">{{ mf.value }}</p>
    {%- else -%}
      {%- capture _mf_tagged -%}{{ mf | metafield_tag }}{%- endcapture -%}
      {%- assign _mf_tagged = _mf_tagged | strip -%}
      {%- if _mf_tagged != blank -%}
        {{- _mf_tagged -}}
      {%- elsif mf.value != blank -%}
        <div class="rte">{{ mf.value }}</div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
