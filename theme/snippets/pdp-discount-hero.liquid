{% comment %}
  Discount PDP — price-first hero with tier badge and strike-through.
  Compact, high-impact, no filler text. The price speaks for itself.
{% endcomment %}
{%- liquid
  assign ph_only_when_on_sale = section.settings.discount_only_when_on_sale | default: false
  assign ph_show_unit_hint = section.settings.discount_show_unit_hint | default: true

  assign v = product.selected_or_first_available_variant
  assign compare_at = v.compare_at_price
  assign price = v.price
  # compare_at_price_max only safe for single-variant; else max can be another SKU's MSRP
  if compare_at == blank or compare_at == 0
    if product.has_only_default_variant
      assign compare_at = product.compare_at_price_max
    endif
  endif
  if compare_at == blank
    assign compare_at = 0
  endif
  assign on_sale = false
  assign discount_pct = 0
  assign saved_amount = 0
  if compare_at > price
    assign saved_amount = compare_at | minus: price
    if saved_amount > 0
      assign discount_pct = saved_amount | times: 100.0 | divided_by: compare_at | round
      if discount_pct >= 1
        assign on_sale = true
      else
        assign saved_amount = 0
        assign discount_pct = 0
      endif
    endif
  endif

  assign show_band = true
  if ph_only_when_on_sale and on_sale == false
    assign show_band = false
  endif
-%}
{% if show_band %}
  {%- liquid
    if discount_pct > 100
      assign discount_pct = 100
    endif

    assign tier_level = 1
    if discount_pct >= 30
      assign tier_level = 3
    elsif discount_pct >= 15
      assign tier_level = 2
    endif
    case tier_level
      when 3
        assign tier_label = 'macross.pdp_sale_tier_3' | t
      when 2
        assign tier_label = 'macross.pdp_sale_tier_2' | t
      else
        assign tier_label = 'macross.pdp_sale_tier_1' | t
    endcase

    assign money_sale = price | money
    assign money_compare = compare_at | money
    assign money_saved = saved_amount | money
    if settings.currency_code_enabled
      assign money_sale = price | money_with_currency
      assign money_compare = compare_at | money_with_currency
      assign money_saved = saved_amount | money_with_currency
    endif

    assign pay_pct = 100 | minus: discount_pct
    assign region_aria = 'macross.pdp_sale_region_aria' | t: pct: discount_pct, pay_pct: pay_pct, tier: tier_label, compare: money_compare, sale: money_sale
  -%}
  <div
    class="mp-offer mp-offer--tier-{{ tier_level }}{% unless on_sale %} mp-offer--regular{% endunless %}"
    role="region"
    data-discount-pdp-hero
    data-tier-label-1="{{ 'macross.pdp_sale_tier_1' | t | escape }}"
    data-tier-label-2="{{ 'macross.pdp_sale_tier_2' | t | escape }}"
    data-tier-label-3="{{ 'macross.pdp_sale_tier_3' | t | escape }}"
    aria-label="{{ product.title }}. {{ region_aria | strip_html | escape }}"
  >
    <div class="mp-offer__glow" aria-hidden="true"></div>

    <div class="mp-offer__badge{% unless on_sale %} hidden{% endunless %}" data-mp-offer-badge aria-hidden="true">
      <span class="mp-offer__badge-pct"><span data-mp-offer-pct>-{{ discount_pct }}%</span></span>
    </div>

    <h1 class="mp-offer__title">{{ product.title }}</h1>

    <div class="mp-offer__prices{% unless on_sale %} mp-offer__prices--solo{% endunless %}">
      <span class="mp-offer__now{% unless on_sale %} mp-offer__now--regular{% endunless %}" data-mp-offer-now>{{ money_sale }}</span>
      <span class="mp-offer__was{% unless on_sale %} hidden{% endunless %}" data-mp-offer-was-wrap>
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <s data-mp-offer-compare>{% if on_sale %}{{ money_compare }}{% endif %}</s>
      </span>
    </div>

    <div class="mp-offer__tier{% unless on_sale %} hidden{% endunless %}" data-mp-offer-tier>
      <span class="mp-offer__tier-label" data-mp-offer-tier-label>{{ tier_label }}</span>
      <span class="mp-offer__tier-saved">{{ 'macross.pdp_sale_you_save' | t }} <span data-mp-offer-saved-amount>{{ money_saved }}</span></span>
    </div>

    {% if ph_show_unit_hint %}
      <p
        class="mp-offer__unit{% unless v.unit_price_measurement %} hidden{% endunless %}"
        data-mp-offer-unit-row
      >
        <span data-mp-offer-unit-inner>
          {% if v.unit_price_measurement %}
            {{- v.unit_price | money -}}
            <span aria-hidden="true"> / </span>
            {%- if v.unit_price_measurement.reference_value != 1 -%}
              {{- v.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{- v.unit_price_measurement.reference_unit -}}
          {% endif %}
        </span>
      </p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  /* Light card only; avoids OS dark mode flipping the masthead to black */
  .mp-offer {
    color-scheme: light;
    color: rgba(26, 20, 18, 0.92);
    --offer-red: var(--mp-red, #b33029);
    --offer-red-soft: var(--mp-red-soft, #d45850);
    --offer-paper: var(--mp-warm-paper, #f6f1e7);

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem 1.35rem 1.15rem;
    border-radius: 0.85rem;
    overflow: hidden;
    background: linear-gradient(165deg, #fffcfb 0%, #f8f4f0 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 0 0 1px rgba(179, 48, 41, 0.22),
      0 6px 24px rgba(42, 34, 32, 0.1);
    outline: 1px solid rgba(102, 102, 102, 0.35);
    outline-offset: 2px;
    font-family: var(--discount-pdp-font-ui);
    -webkit-font-smoothing: antialiased;
  }

  .mp-offer__glow {
    position: absolute;
    top: -60%;
    left: -30%;
    width: 100%;
    height: 140%;
    background: radial-gradient(ellipse 65% 50% at 25% 35%, rgba(179, 48, 41, 0.18), transparent 60%);
    pointer-events: none;
    filter: blur(40px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mp-offer__glow {
      animation: mp-offer-pulse 6s ease-in-out infinite alternate;
    }
  }

  @keyframes mp-offer-pulse {
    0% { opacity: 0.7; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.08); }
  }

  .mp-offer__title {
    position: relative;
    z-index: 1;
    margin: 0;
    padding-right: 5.5rem;
    font-family: var(--discount-pdp-font-display);
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: rgba(26, 20, 18, 0.92);
  }

  .mp-offer__badge {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.55rem 0.9rem 0.5rem;
    background: linear-gradient(145deg, var(--offer-red-soft), var(--offer-red));
    border-radius: 0 0.85rem 0 0.75rem;
    box-shadow:
      0 4px 16px rgba(179, 48, 41, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .mp-offer__badge-pct {
    font-family: var(--discount-pdp-font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .mp-offer--tier-2 .mp-offer__badge {
    min-width: 5rem;
  }

  .mp-offer--tier-2 .mp-offer__badge-pct {
    font-size: 1.3rem;
  }

  .mp-offer--tier-3 .mp-offer__badge {
    min-width: 5.5rem;
    padding: 0.65rem 1rem 0.6rem;
  }

  .mp-offer--tier-3 .mp-offer__badge-pct {
    font-size: 1.5rem;
  }

  .mp-offer__prices {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
    padding-right: 5.5rem;
  }

  .mp-offer__prices--solo {
    padding-right: 0;
  }

  .mp-offer__now {
    font-family: var(--discount-pdp-font-display);
    font-size: clamp(2rem, 5.5vw, 2.65rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--offer-red);
  }

  .mp-offer__now--regular {
    color: rgba(26, 20, 18, 0.85);
  }

  .mp-offer__was {
    font-family: var(--discount-pdp-font-ui);
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: rgba(42, 34, 32, 0.55);
  }

  .mp-offer__was s {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgba(179, 48, 41, 0.5);
  }

  .mp-offer__tier {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
  }

  .mp-offer__tier-label {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem 0.25rem;
    border-radius: 0.3rem;
    background: rgba(42, 34, 32, 0.05);
    border: 1px solid rgba(42, 34, 32, 0.1);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(42, 34, 32, 0.78);
  }

  .mp-offer--tier-2 .mp-offer__tier-label,
  .mp-offer--tier-3 .mp-offer__tier-label {
    background: rgba(179, 48, 41, 0.1);
    border-color: rgba(179, 48, 41, 0.2);
    color: var(--offer-red);
  }

  .mp-offer__tier-saved {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--offer-red);
  }

  .mp-offer__unit {
    position: relative;
    z-index: 1;
    margin: 0.25rem 0 0;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(42, 34, 32, 0.1);
    font-size: 0.72rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: rgba(42, 34, 32, 0.55);
  }

  .mp-offer--regular {
    background: linear-gradient(165deg, #fdfbfa 0%, #f5f2ef 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 0 0 1px rgba(42, 34, 32, 0.08),
      0 4px 16px rgba(42, 34, 32, 0.06);
  }

  .mp-offer--regular .mp-offer__glow {
    display: none;
  }
{% endstylesheet %}
